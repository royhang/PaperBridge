{
  "name": "paperbridge",
  "private": true,
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/fetch-fonts.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/fetch-fonts.mjs",
    "proxy": "node proxy/server.mjs",
    "test:proxy": "node --test proxy/test.mjs",
    "sync": "node sync/server.mjs",
    "test:sync": "node --test sync/test.mjs",
    "test:docker": "node --test docker/test.mjs",
    "test:lan": "node --test desktop/test.mjs",
    "desktop": "pnpm build && pnpm -C desktop start",
    "desktop:win": "pnpm build && pnpm -C desktop dist:win",
    "desktop:linux": "pnpm build && pnpm -C desktop dist:linux",
    "desktop:mac": "pnpm build && pnpm -C desktop dist:mac"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "blueimp-md5": "^2.19.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.4",
    "katex": "^0.19.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
