{
  "name": "PaperBridge 文献阅读翻译",
  "short_name": "PaperBridge",
  "description": "开源学术文献阅读、保版式全文对照、手写批注与多端云同步工具，支持电脑、iPad 与安卓平板/手机",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#14161a",
  "theme_color": "#14161a",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
